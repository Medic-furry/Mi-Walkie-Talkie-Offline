<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- 频道内容（占位行时整块隐藏） -->
    <LinearLayout
        android:id="@+id/contentBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题行：序号+名称 + 拖拽把手（按下把手即发起上下拖拽排序；行本身长按仍是选项菜单） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 整理模式多选复选框（非整理模式隐藏） -->
            <CheckBox
                android:id="@+id/chCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/organize_channel_check"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- 拖拽把手：按下并长按 2 秒才起拖（把手太小、 swipe 时易误触，用户要求阈值 2 秒）。
                 56dp 命中区 > Material 推荐的 48dp 最小触控区 -->
            <TextView
                android:id="@+id/chDrag"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="≡"
                android:textColor="#9E9E9E"
                android:textSize="26sp"
                android:contentDescription="@string/reorder_drag_handle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chRxFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/frequency_rx"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chTxFreq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/frequency_tx"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />
    </LinearLayout>

    <!-- 空槽占位行：拖拽开始时插入列表，作为可放置目标（不可被拖动） -->
    <LinearLayout
        android:id="@+id/placeholderBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_slot_placeholder"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/slotNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90A4AE"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/slot_empty_hint"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
